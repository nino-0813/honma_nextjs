# ローカル開発用の環境変数サンプル（Next.js 専用）
# このファイルをコピーして .env.local を作成し、実際の値を設定してください

# Supabase（クライアント・サーバー両方で参照する場合は NEXT_PUBLIC_ 必須）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe（クライアント側：NEXT_PUBLIC_ / サーバー側：プレフィックスなし）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
# 通常購入だけ日本の銀行振込を表示。未設定/falseなら従来どおりカードのみ。
ENABLE_STRIPE_BANK_TRANSFER=false
# Stripe Webhook署名検証（stripe listen の whsec_... またはDashboardの値）
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# 銀行振込の在庫確保・期限切れ処理に必要（ブラウザへ公開しない）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Vercel Cronから期限切れ処理を呼ぶための十分に長いランダム文字列
CRON_SECRET=your_cron_secret

# ヒーロー動画（任意）Supabase Storage の MP4 URL
# 未設定の場合は静止画で表示されます
NEXT_PUBLIC_HERO_VIDEO_URL=https://wlyqannomdudlapsolwp.supabase.co/storage/v1/object/public/site-images/hero/IKEVEGE.mp4

# 本番の正規URL（OGP・JSON-LD 用。Vercel では VERCEL_URL が自動設定されます）
# NEXT_PUBLIC_SITE_URL=https://ikevege.com

# Resend（メール送信。管理画面などで利用する場合）
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
